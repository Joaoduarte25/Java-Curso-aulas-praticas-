    private void btnVotoActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnVotoActionPerformed
        // TODO add your handling code here:
        int anoAtual = java.time.Year.now().getValue();
        int ano = Integer.parseInt(txtAno.getText());
        int idade = anoAtual - ano;
        
        if( idade < 16){
            lblResultado.setText("não vota " + "sua idade: " + idade + " anos e o ano que estamos é: " + anoAtual);
        }else{
            if((idade >=16 && idade<18) || (idade > 70)){
                lblResultado.setText("Voto Opcional " + "sua idade: " + idade + " anos e o ano que estamos é: " + anoAtual);
            }else{
                lblResultado.setText("Obrigatorio " + "sua idade: " + idade + " anos e o ano que estamos é: " + anoAtual);
            }
        }
        panResultado.setVisible(true);
    }//GEN-LAST:event_btnVotoActionPerformed

